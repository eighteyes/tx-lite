#!/usr/bin/env bash
# txlit - Inter-agent messaging for Claude Code
# Mailbox system: register message pointers, hook delivers on prompt submit
#
# Responsibilities:
# - init: one-time global setup (config dir, hook, settings.json, CLAUDE.md)
# - send: register a handoff file pointer in the global registry
# - list: display pending messages
# - clear: remove messages from registry
# - install: init + symlink to PATH
# - uninstall: remove hook, config, symlink, CLAUDE.md section
# - help: progressive-reveal usage for agents

set -euo pipefail

CONFIG_DIR="${HOME}/.config/txlit"
MESSAGES_FILE="${CONFIG_DIR}/messages.json"
REGISTRY_FILE="${CONFIG_DIR}/registry.json"
CLAUDE_SETTINGS="${HOME}/.claude/settings.json"
CLAUDE_MD="${HOME}/.claude/CLAUDE.md"
INSTALL_DIR="${HOME}/.local/bin"

# Resolve script location (follows one level of symlink)
get_script_dir() {
    local source="$0"
    local dir
    dir="$(cd "$(dirname "$source")" && pwd)"
    if [ -L "$source" ]; then
        local link
        link="$(readlink "$source")"
        case "$link" in
            /*) dir="$(dirname "$link")" ;;
            *)  dir="$(cd "$dir" && cd "$(dirname "$link")" && pwd)" ;;
        esac
    fi
    echo "$dir"
}

SCRIPT_DIR="$(get_script_dir)"
HOOK_SOURCE="${SCRIPT_DIR}/../lib/hook.sh"

# Atomic JSON write: stdin → file
json_write() {
    local file="$1"
    local tmpfile="${file}.tmp.$$"
    cat > "$tmpfile" && mv "$tmpfile" "$file"
}

# Resolve a target: registered name → path, or pass through as path
# Handles both old format (string) and new format (object with .path)
resolve_target() {
    local target="$1"
    if [ -f "$REGISTRY_FILE" ]; then
        local resolved
        resolved="$(jq -r --arg name "$target" '.[$name] | if type == "object" then .path else . end // empty' "$REGISTRY_FILE" 2>/dev/null)"
        if [ -n "$resolved" ]; then
            echo "$resolved"
            return
        fi
    fi
    echo "$target"
}

# --- init -----------------------------------------------------------
cmd_init() {
    echo "Initializing txlit..."
    echo ""

    # Config directory
    mkdir -p "$CONFIG_DIR"
    echo "  [ok] Config directory: ${CONFIG_DIR}"

    # Messages registry
    if [ ! -f "$MESSAGES_FILE" ]; then
        echo '{}' > "$MESSAGES_FILE"
        echo "  [ok] Created messages registry"
    else
        echo "  [--] Messages registry exists"
    fi

    # Name registry
    if [ ! -f "$REGISTRY_FILE" ]; then
        echo '{}' > "$REGISTRY_FILE"
        echo "  [ok] Created name registry"
    else
        echo "  [--] Name registry exists"
    fi

    # Install hook script
    if [ -f "$HOOK_SOURCE" ]; then
        cp "$HOOK_SOURCE" "${CONFIG_DIR}/hook.sh"
        chmod +x "${CONFIG_DIR}/hook.sh"
        echo "  [ok] Installed hook script"
    else
        echo "  [!!] Hook source not found at ${HOOK_SOURCE}" >&2
        echo "       Copy lib/hook.sh to ${CONFIG_DIR}/hook.sh manually." >&2
    fi

    # Register hook in global settings.json
    if [ ! -f "$CLAUDE_SETTINGS" ]; then
        mkdir -p "$(dirname "$CLAUDE_SETTINGS")"
        printf '%s\n' '{"hooks":{"UserPromptSubmit":[{"hooks":[{"type":"command","command":"$HOME/.config/txlit/hook.sh","timeout":10}]}]}}' \
            | jq '.' > "$CLAUDE_SETTINGS"
        echo "  [ok] Created ${CLAUDE_SETTINGS} with hook"
    elif jq -e '.hooks.UserPromptSubmit // [] | map(select(.hooks[]?.command | test("txlit"))) | length > 0' "$CLAUDE_SETTINGS" > /dev/null 2>&1; then
        echo "  [--] Hook already registered in settings"
    else
        jq '.hooks //= {} | .hooks.UserPromptSubmit //= [] | .hooks.UserPromptSubmit += [{"hooks":[{"type":"command","command":"$HOME/.config/txlit/hook.sh","timeout":10}]}]' \
            "$CLAUDE_SETTINGS" | json_write "$CLAUDE_SETTINGS"
        echo "  [ok] Added hook to ${CLAUDE_SETTINGS}"
    fi

    # Add instructions to global CLAUDE.md
    if [ -f "$CLAUDE_MD" ]; then
        if grep -q "txlit" "$CLAUDE_MD" 2>/dev/null; then
            echo "  [--] CLAUDE.md already has txlit instructions"
        else
            printf '\n## Inter-Agent Messaging\nThis machine uses txlit for inter-agent messaging. Run `txlit -h` for usage.\n' >> "$CLAUDE_MD"
            echo "  [ok] Added txlit section to CLAUDE.md"
        fi
    else
        echo "  [!!] No CLAUDE.md found at ${CLAUDE_MD}"
    fi

    echo ""
    echo "Done. Run 'txlit -h' for usage."
}

# --- send -----------------------------------------------------------
cmd_send() {
    local target_path="${1:-}"
    local handoff_file="${2:-}"

    if [ -z "$target_path" ] || [ -z "$handoff_file" ]; then
        echo "Usage: txlit send <target|name> <handoff-file>" >&2
        echo "" >&2
        echo "  target   Path or registered name (see: txlit who)" >&2
        echo "  handoff  Filename in <target>/.ai/tx/msgs/" >&2
        exit 1
    fi

    # Resolve registered name → path
    target_path="$(resolve_target "$target_path")"

    # Resolve to absolute path
    target_path="$(cd "$target_path" 2>/dev/null && pwd)" || {
        echo "Error: target path does not exist: $1" >&2
        exit 1
    }

    # Check handoff file exists
    local handoff_path="${target_path}/.ai/tx/msgs/${handoff_file}"
    if [ ! -f "$handoff_path" ]; then
        echo "Error: handoff file not found: ${handoff_path}" >&2
        exit 1
    fi

    # Ensure initialized
    if [ ! -f "$MESSAGES_FILE" ]; then
        echo "Error: txlit not initialized. Run 'txlit init' first." >&2
        exit 1
    fi

    # Generate message ID
    local msg_id
    msg_id="$(uuidgen | tr '[:upper:]' '[:lower:]' | cut -c1-8)"

    # Sender = current project or working directory
    local from_path="${CLAUDE_PROJECT_DIR:-$PWD}"

    # Timestamp
    local timestamp
    timestamp="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"

    # Append to registry (atomic write)
    jq --arg target "$target_path" \
       --arg id "$msg_id" \
       --arg from "$from_path" \
       --arg handoff "$handoff_path" \
       --arg ts "$timestamp" \
       '.[$target] //= [] | .[$target] += [{"id":$id,"from":$from,"handoff":$handoff,"timestamp":$ts,"status":"unread"}]' \
       "$MESSAGES_FILE" | json_write "$MESSAGES_FILE"

    echo "Registered message ${msg_id}"
    echo "  to:      ${target_path}"
    echo "  handoff: ${handoff_file}"
}

# --- list -----------------------------------------------------------
cmd_list() {
    local filter_path="${1:-}"

    if [ ! -f "$MESSAGES_FILE" ]; then
        echo "No messages (txlit not initialized)"
        return
    fi

    if [ -n "$filter_path" ]; then
        # Resolve registered name → path
        filter_path="$(resolve_target "$filter_path")"
        filter_path="$(cd "$filter_path" 2>/dev/null && pwd)" || filter_path="$1"

        local count
        count="$(jq --arg p "$filter_path" '.[$p] // [] | length' "$MESSAGES_FILE")"

        if [ "$count" = "0" ]; then
            echo "No messages for ${filter_path}"
            return
        fi

        echo "Messages for ${filter_path} (${count}):"
        jq -r --arg p "$filter_path" \
          '.[$p] // [] | .[] | "  [\(.id)] \(.status)  from \(.from | split("/") | last)  \(.timestamp)  \(.handoff | split("/") | last)"' \
          "$MESSAGES_FILE"
    else
        local total
        total="$(jq '[.[] | length] | add // 0' "$MESSAGES_FILE")"

        if [ "$total" = "0" ]; then
            echo "No pending messages"
            return
        fi

        echo "All messages (${total}):"
        jq -r 'to_entries[] | select(.value | length > 0) | "\n\(.key):", (.value[] | "  [\(.id)] \(.status)  from \(.from | split("/") | last)  \(.timestamp)  \(.handoff | split("/") | last)")' \
          "$MESSAGES_FILE"
    fi
}

# --- clear ----------------------------------------------------------
cmd_clear() {
    local clear_path="${1:-}"
    local msg_id="${2:-}"

    if [ -z "$clear_path" ]; then
        echo "Usage: txlit clear <path> [message-id]" >&2
        exit 1
    fi

    if [ ! -f "$MESSAGES_FILE" ]; then
        echo "No messages (txlit not initialized)"
        return
    fi

    # Resolve registered name → path
    clear_path="$(resolve_target "$clear_path")"
    clear_path="$(cd "$clear_path" 2>/dev/null && pwd)" || clear_path="$1"

    if [ -n "$msg_id" ]; then
        # Remove specific message
        jq --arg p "$clear_path" --arg id "$msg_id" \
          'if .[$p] then .[$p] |= map(select(.id != $id)) | if .[$p] | length == 0 then del(.[$p]) else . end else . end' \
          "$MESSAGES_FILE" | json_write "$MESSAGES_FILE"
        echo "Cleared message ${msg_id} from ${clear_path}"
    else
        # Remove all for path
        jq --arg p "$clear_path" 'del(.[$p])' "$MESSAGES_FILE" | json_write "$MESSAGES_FILE"
        echo "Cleared all messages for ${clear_path}"
    fi
}

# --- register -------------------------------------------------------
cmd_register() {
    local name="${1:-}"
    local reg_path="${2:-$PWD}"
    local intent="${3:-}"

    if [ -z "$name" ]; then
        echo "Usage: txlit register <name> [path] [intent]" >&2
        echo "" >&2
        echo "  name     Alias for the project (e.g., prototypologist)" >&2
        echo "  path     Project directory (default: current directory)" >&2
        echo "  intent   What this project is about" >&2
        exit 1
    fi

    # Resolve to absolute path
    reg_path="$(cd "$reg_path" 2>/dev/null && pwd)" || {
        echo "Error: path does not exist: ${2:-$PWD}" >&2
        exit 1
    }

    # Ensure registry exists
    if [ ! -f "$REGISTRY_FILE" ]; then
        echo '{}' > "$REGISTRY_FILE"
    fi

    if [ -n "$intent" ]; then
        jq --arg name "$name" --arg path "$reg_path" --arg intent "$intent" \
          '.[$name] = {"path":$path,"intent":$intent}' "$REGISTRY_FILE" | json_write "$REGISTRY_FILE"
        echo "Registered '${name}' → ${reg_path}"
        echo "  intent: ${intent}"
    else
        # Preserve existing intent if re-registering with new path
        jq --arg name "$name" --arg path "$reg_path" \
          'if .[$name] | type == "object" then .[$name].path = $path else .[$name] = {"path":$path} end' \
          "$REGISTRY_FILE" | json_write "$REGISTRY_FILE"
        echo "Registered '${name}' → ${reg_path}"
    fi
}

# --- intent ---------------------------------------------------------
cmd_intent() {
    local name="${1:-}"
    local intent="${2:-}"

    if [ -z "$name" ] || [ -z "$intent" ]; then
        echo "Usage: txlit intent <name> <intent>" >&2
        exit 1
    fi

    if [ ! -f "$REGISTRY_FILE" ]; then
        echo "No registered names" >&2
        exit 1
    fi

    # Ensure entry exists
    if ! jq -e --arg name "$name" '.[$name]' "$REGISTRY_FILE" > /dev/null 2>&1; then
        echo "Name '${name}' not found. Register it first." >&2
        exit 1
    fi

    jq --arg name "$name" --arg intent "$intent" \
      'if .[$name] | type == "object" then .[$name].intent = $intent else .[$name] = {"path":.[$name],"intent":$intent} end' \
      "$REGISTRY_FILE" | json_write "$REGISTRY_FILE"

    echo "Updated intent for '${name}': ${intent}"
}

# --- unregister -----------------------------------------------------
cmd_unregister() {
    local name="${1:-}"

    if [ -z "$name" ]; then
        echo "Usage: txlit unregister <name>" >&2
        exit 1
    fi

    if [ ! -f "$REGISTRY_FILE" ]; then
        echo "No registered names"
        return
    fi

    if jq -e --arg name "$name" '.[$name]' "$REGISTRY_FILE" > /dev/null 2>&1; then
        jq --arg name "$name" 'del(.[$name])' "$REGISTRY_FILE" | json_write "$REGISTRY_FILE"
        echo "Unregistered '${name}'"
    else
        echo "Name '${name}' not found" >&2
        exit 1
    fi
}

# --- who ------------------------------------------------------------
cmd_who() {
    if [ ! -f "$REGISTRY_FILE" ]; then
        echo "No registered names"
        return
    fi

    local count
    count="$(jq 'length' "$REGISTRY_FILE")"

    if [ "$count" = "0" ]; then
        echo "No registered names"
        return
    fi

    echo "Registered names (${count}):"
    jq -r 'to_entries[] |
      if .value | type == "object" then
        "  \(.key)  →  \(.value.path)" + (if .value.intent then "\n    \(.value.intent)" else "" end)
      else
        "  \(.key)  →  \(.value)"
      end' "$REGISTRY_FILE"
}

# --- install --------------------------------------------------------
cmd_install() {
    local bin_dir="${1:-$INSTALL_DIR}"

    # Resolve the real script path (not the symlink)
    local real_script
    real_script="${SCRIPT_DIR}/txlit"

    # Run init first
    cmd_init

    echo ""

    # Create bin directory
    mkdir -p "$bin_dir"

    # Symlink txlit to PATH
    local link_path="${bin_dir}/txlit"
    if [ -L "$link_path" ]; then
        local existing
        existing="$(readlink "$link_path")"
        if [ "$existing" = "$real_script" ]; then
            echo "  [--] Symlink already exists: ${link_path} → ${real_script}"
        else
            ln -sf "$real_script" "$link_path"
            echo "  [ok] Updated symlink: ${link_path} → ${real_script}"
        fi
    elif [ -f "$link_path" ]; then
        echo "  [!!] ${link_path} exists and is not a symlink. Remove it first." >&2
    else
        ln -s "$real_script" "$link_path"
        echo "  [ok] Symlinked: ${link_path} → ${real_script}"
    fi

    # Check if bin_dir is in PATH
    case ":${PATH}:" in
        *":${bin_dir}:"*) ;;
        *) echo "  [!!] ${bin_dir} is not in your PATH. Add it to your shell profile." >&2 ;;
    esac

    echo ""
    echo "Installed. Run 'txlit -h' from anywhere."
}

# --- uninstall ------------------------------------------------------
cmd_uninstall() {
    echo "Uninstalling txlit..."
    echo ""

    # Remove symlink
    local link_path="${INSTALL_DIR}/txlit"
    if [ -L "$link_path" ]; then
        rm "$link_path"
        echo "  [ok] Removed symlink: ${link_path}"
    else
        echo "  [--] No symlink at ${link_path}"
    fi

    # Remove hook from settings.json
    if [ -f "$CLAUDE_SETTINGS" ] && jq -e '.hooks.UserPromptSubmit' "$CLAUDE_SETTINGS" > /dev/null 2>&1; then
        jq '.hooks.UserPromptSubmit |= map(select(.hooks | all(.command | test("txlit") | not))) | if .hooks.UserPromptSubmit | length == 0 then del(.hooks.UserPromptSubmit) else . end' \
            "$CLAUDE_SETTINGS" | json_write "$CLAUDE_SETTINGS"
        echo "  [ok] Removed hook from ${CLAUDE_SETTINGS}"
    else
        echo "  [--] No hook found in settings"
    fi

    # Remove txlit section from CLAUDE.md
    if [ -f "$CLAUDE_MD" ] && grep -q "## Inter-Agent Messaging" "$CLAUDE_MD" 2>/dev/null; then
        # Remove the section (header + following line)
        sed '/^## Inter-Agent Messaging$/,/^$/d' "$CLAUDE_MD" > "${CLAUDE_MD}.tmp" && mv "${CLAUDE_MD}.tmp" "$CLAUDE_MD"
        echo "  [ok] Removed txlit section from CLAUDE.md"
    else
        echo "  [--] No txlit section in CLAUDE.md"
    fi

    # Remove config directory
    if [ -d "$CONFIG_DIR" ]; then
        rm -r "$CONFIG_DIR"
        echo "  [ok] Removed ${CONFIG_DIR}"
    else
        echo "  [--] No config directory at ${CONFIG_DIR}"
    fi

    echo ""
    echo "Uninstalled. Source files remain at ${SCRIPT_DIR}/../"
}

# --- help -----------------------------------------------------------
cmd_help() {
    cat << 'HELP'
txlit - Inter-agent messaging for Claude Code

USAGE:
  txlit install [bin-dir]             Init + symlink to PATH (default: ~/.local/bin)
  txlit uninstall                     Remove hook, config, symlink, CLAUDE.md section
  txlit init                          Setup without symlink
  txlit register <name> [path] [intent] Name a project (default: current dir)
  txlit intent <name> <intent>        Update a project's intent
  txlit unregister <name>             Remove a named project
  txlit who                           List registered names + intents
  txlit send <target|name> <handoff>  Register a message for a project
  txlit list [path|name]              Show pending messages
  txlit clear <path|name> [id]        Remove messages
  txlit help                          Show this help

WORKFLOW:
  1. Register project names:    txlit register backend ~/projects/backend
  2. Agent writes handoff:      <target>/.ai/tx/msgs/YYYY-MM-DD-name.md
  3. Agent sends message:       txlit send backend 2026-02-13-setup-auth.md
  4. Receiving agent gets it on next prompt
  5. Clear after processing:    txlit clear backend

FILES:
  ~/.config/txlit/messages.json      Global message registry
  ~/.config/txlit/registry.json      Named project aliases
  ~/.config/txlit/hook.sh            Hook script (installed by init)
  <project>/.ai/tx/msgs/*.md        Handoff instruction files

EXAMPLES:
  txlit register prototypologist ~/projects/prototypologist "AI prototyping sandbox"
  txlit intent tx-core "Core transaction engine"
  txlit send prototypologist 2026-02-13-setup-auth.md
  txlit send ~/projects/backend 2026-02-13-setup-auth.md
  txlit list
  txlit list prototypologist
  txlit clear prototypologist
  txlit clear prototypologist a1b2c3d4
  txlit who
HELP
}

# --- routing --------------------------------------------------------
case "${1:-}" in
    install)        shift; cmd_install "$@" ;;
    uninstall)      shift; cmd_uninstall "$@" ;;
    init)           shift; cmd_init "$@" ;;
    register)       shift; cmd_register "$@" ;;
    intent)         shift; cmd_intent "$@" ;;
    unregister)     shift; cmd_unregister "$@" ;;
    who)            shift; cmd_who "$@" ;;
    send)           shift; cmd_send "$@" ;;
    list|ls)        shift; cmd_list "$@" ;;
    clear|rm)       shift; cmd_clear "$@" ;;
    help|-h|--help) cmd_help ;;
    "")             cmd_help ;;
    *)              echo "Unknown command: $1" >&2; cmd_help >&2; exit 1 ;;
esac
