#!/usr/bin/env bash
# txlit - Inter-agent messaging for Claude Code
# Mailbox system: register message pointers, hook delivers on prompt submit
#
# Responsibilities:
# - compose: write + register a message (-m inline or stdin)
# - send: register a handoff file pointer in the global registry
# - term grab: pull terminal output from kitty into current session (stdout)
# - term relay: grab terminal output from kitty and send as a message
# - list: display pending messages
# - clear: remove messages from registry
# - publish: append a JSON-line to <target>'s channel file (fire-and-forget pub/sub)
# - listen: truncate then tail current project's channel file (Monitor-friendly stream)
# - help: progressive-reveal usage for agents

set -euo pipefail

CONFIG_DIR="${HOME}/.config/txlit"
MESSAGES_FILE="${CONFIG_DIR}/messages.json"
REGISTRY_FILE="${CONFIG_DIR}/registry.json"
MSGS_DIR="${CONFIG_DIR}/msgs"
CHANNELS_DIR="${CONFIG_DIR}/channels"

# Atomic JSON write: stdin → file (refuses to clobber with empty/invalid JSON)
json_write() {
    local file="$1"
    local tmpfile="${file}.tmp.$$"
    cat > "$tmpfile"
    if [ ! -s "$tmpfile" ] || ! jq empty "$tmpfile" 2>/dev/null; then
        rm -f "$tmpfile"
        echo "Error: json_write refused to write empty/invalid JSON to ${file}" >&2
        return 1
    fi
    mv "$tmpfile" "$file"
}

# mkdir-based advisory lock for messages.json
# Usage: messages_lock_acquire  /  messages_lock_release
# Retries for up to ~5 seconds; breaks stale lock after 5s by mtime.
# On failure: prints warning to stderr and returns 1.
_MESSAGES_LOCK_DIR="${CONFIG_DIR}/.messages.lock"

messages_lock_acquire() {
    local deadline=$(( $(date +%s) + 5 ))
    while ! mkdir "$_MESSAGES_LOCK_DIR" 2>/dev/null; do
        local now
        now="$(date +%s)"
        if [ "$now" -ge "$deadline" ]; then
            echo "txlit: warning: could not acquire messages.json lock after 5s" >&2
            return 1
        fi
        # Break stale lock: if lock dir mtime is >5s old, remove and retry
        local lock_mtime
        lock_mtime="$(stat -f '%m' "$_MESSAGES_LOCK_DIR" 2>/dev/null || echo 0)"
        if [ "$now" -ge $(( lock_mtime + 5 )) ]; then
            rmdir "$_MESSAGES_LOCK_DIR" 2>/dev/null || true
        fi
        sleep 0.1
    done
    # Ensure lock is released on unexpected exit
    trap 'messages_lock_release' EXIT
    return 0
}

messages_lock_release() {
    rmdir "$_MESSAGES_LOCK_DIR" 2>/dev/null || true
    # Remove the trap we set in acquire (restore to no-op)
    trap - EXIT
}

# Resolve a target: registered name → path, or pass through as path
# Handles both old format (string) and new format (object with .path)
resolve_target() {
    local target="$1"
    if [ -f "$REGISTRY_FILE" ]; then
        local resolved
        resolved="$(jq -r --arg name "$target" '.[$name] | if type == "object" then .path else . end // empty' "$REGISTRY_FILE" 2>/dev/null)"
        if [ -n "$resolved" ]; then
            echo "$resolved"
            return
        fi
    fi
    echo "$target"
}

# Resolve a target path to a namespace for central message storage
# Checks registry for a name mapping to this path, falls back to basename
# Detect if a recipient namespace has a live `txlit listen` process
# Echoes "true" or "false"; cleans up stale pidfiles
listener_active() {
    local ns="$1"
    local pidfile="${CHANNELS_DIR}/${ns}.pid"
    if [ -f "$pidfile" ]; then
        local lpid
        lpid="$(cat "$pidfile" 2>/dev/null)"
        if [ -n "$lpid" ] && kill -0 "$lpid" 2>/dev/null; then
            echo "true"; return
        fi
        rm -f "$pidfile"
    fi
    echo "false"
}

# Dual-write a message: queue (messages.json) + live channel (channels/<ns>.jsonl)
# Args: target_path msg_id from_path handoff_path timestamp namespace
# Reads body from handoff_path. Stamps queue read if listener is live.
dual_write_message() {
    local target_path="$1" msg_id="$2" from_path="$3" handoff_path="$4" timestamp="$5" namespace="$6"

    local live status
    live="$(listener_active "$namespace")"
    status="unread"; [ "$live" = "true" ] && status="read"

    messages_lock_acquire || return 1
    jq --arg target "$target_path" \
       --arg id "$msg_id" \
       --arg from "$from_path" \
       --arg handoff "$handoff_path" \
       --arg ts "$timestamp" \
       --arg status "$status" \
       '.[$target] //= [] | .[$target] += [{"id":$id,"from":$from,"handoff":$handoff,"timestamp":$ts,"status":$status}]' \
       "$MESSAGES_FILE" | json_write "$MESSAGES_FILE"
    messages_lock_release

    mkdir -p "$CHANNELS_DIR"
    local channel_file="${CHANNELS_DIR}/${namespace}.jsonl"
    local from_ns
    from_ns="$(resolve_namespace "$(cd "$from_path" 2>/dev/null && pwd || echo "$from_path")")"
    # Per-agent identity: distinguishes multiple agents sharing one namespace/channel.
    # Lets a listener drop its own echoes (see cmd_listen) without dropping a
    # sibling agent's messages in the same project folder.
    local from_session="${CLAUDE_CODE_SESSION_ID:-}"
    local body
    body="$(cat "$handoff_path" 2>/dev/null || echo "")"
    jq -cn \
        --arg id "$msg_id" \
        --arg from "$from_ns" \
        --arg session "$from_session" \
        --arg ts "$timestamp" \
        --arg handoff "$handoff_path" \
        --arg body "$body" \
        '{id:$id, from:$from, from_session:$session, ts:$ts, handoff:$handoff, body:$body}' \
        >> "$channel_file"

    # Echo status for caller diagnostics
    echo "$status"
}

resolve_namespace() {
    local target_path="$1"
    if [ -f "$REGISTRY_FILE" ]; then
        local name
        # Prefer non-dash-prefixed names when multiple entries point at the same path
        name="$(jq -r --arg p "$target_path" \
          '[to_entries[] | select((.value | if type == "object" then .path else . end) == $p) | .key]
           | (map(select(startswith("-") | not)) + map(select(startswith("-"))))
           | .[0] // empty' \
          "$REGISTRY_FILE" 2>/dev/null)"
        if [ -n "$name" ]; then
            echo "$name"
            return
        fi
    fi
    basename "$target_path"
}

# --- inbox ----------------------------------------------------------
cmd_inbox() {
    local project_dir="${CLAUDE_PROJECT_DIR:-$PWD}"
    project_dir="$(cd "$project_dir" 2>/dev/null && pwd)" || project_dir="$PWD"

    if [ ! -f "$MESSAGES_FILE" ]; then
        echo "No messages (txlit not initialized)"
        return
    fi

    local unread_count read_count
    unread_count="$(jq --arg p "$project_dir" '[.[$p] // [] | .[] | select(.status == "unread")] | length' "$MESSAGES_FILE")"
    read_count="$(jq --arg p "$project_dir" '[.[$p] // [] | .[] | select(.status == "read")] | length' "$MESSAGES_FILE")"

    if [ "$unread_count" = "0" ] && [ "$read_count" = "0" ]; then
        echo "Inbox empty"
        return
    fi

    if [ "$unread_count" != "0" ]; then
        echo "Unread (${unread_count}):"
        jq -r --arg p "$project_dir" \
          '.[$p] // [] | .[] | select(.status == "unread") | "  [\(.id)] from \(.from | split("/") | last)  \(.timestamp)  \(.handoff | split("/") | last)"' \
          "$MESSAGES_FILE"
    fi

    if [ "$read_count" != "0" ]; then
        echo "Read (${read_count}):"
        jq -r --arg p "$project_dir" \
          '.[$p] // [] | .[] | select(.status == "read") | "  [\(.id)] from \(.from | split("/") | last)  \(.timestamp)  \(.handoff | split("/") | last)"' \
          "$MESSAGES_FILE"
    fi
}

# --- compose --------------------------------------------------------
cmd_compose() {
    local deliver=false
    local tmux_name=""
    local async_mode=""
    local timeout_sec=""
    local target=""
    local filename=""
    local inline_msg=""

    # Parse flags
    while [ $# -gt 0 ]; do
        case "$1" in
            --deliver) deliver=true; shift ;;
            --tmux) tmux_name="$2"; shift 2 ;;
            --async-background) async_mode="single"; shift ;;
            --async-background-monitor) async_mode="monitor"; shift ;;
            --timeout) timeout_sec="$2"; shift 2 ;;
            -m|--message) inline_msg="$2"; shift 2 ;;
            -*) echo "Unknown flag: $1" >&2; exit 1 ;;
            *)
                if [ -z "$target" ]; then target="$1"
                elif [ -z "$filename" ]; then filename="$1"
                fi
                shift ;;
        esac
    done

    # Validate flag combinations
    if [ -n "$async_mode" ] && [ "$deliver" = true ]; then
        echo "Error: --async-background[-monitor] is mutually exclusive with --deliver" >&2
        exit 1
    fi
    if [ -n "$tmux_name" ] && [ "$deliver" = true ]; then
        echo "Error: --tmux is mutually exclusive with --deliver" >&2
        exit 1
    fi

    # Auto-generate filename when not explicitly given
    if [ -z "$filename" ]; then
        local date_prefix
        date_prefix="$(date +"%Y-%m-%d")"
        local short_hash
        short_hash="$(uuidgen | tr '[:upper:]' '[:lower:]' | cut -c1-6)"
        filename="${date_prefix}-${short_hash}.md"
    fi

    if [ -z "$target" ]; then
        echo "Usage: txlit compose [--deliver] [-m <message>] <target|name> [filename]" >&2
        echo "  Writes file and registers message. Filename auto-generated when omitted." >&2
        echo "" >&2
        echo "  --deliver      Launch a new kitty pane and feed the message to claude" >&2
        echo "  -m, --message  Inline message body" >&2
        echo "  target         Path or registered name (see: txlit who)" >&2
        echo "  filename       Name for handoff file (optional; auto-generated as YYYY-MM-DD-xxxxxx.md)" >&2
        echo "" >&2
        echo "Body input (three styles):" >&2
        echo "  -m flag        Inline one-liner" >&2
        echo "  stdin          Heredoc or pipe (multi-line content)" >&2
        echo "  interactive    No -m, no pipe → drops into \$EDITOR with a seeded template" >&2
        echo "" >&2
        echo "Examples:" >&2
        echo "  txlit compose backend -m 'JWT tokens expire after 5 min'" >&2
        echo "  echo 'body' | txlit compose backend" >&2
        echo "  txlit compose backend <<'EOF'" >&2
        echo "  multi-line" >&2
        echo "  body here" >&2
        echo "  EOF" >&2
        echo "  txlit compose backend                # interactive editor" >&2
        exit 1
    fi

    # Resolve registered name → path
    local target_path
    target_path="$(resolve_target "$target")"

    # Resolve to absolute path
    target_path="$(cd "$target_path" 2>/dev/null && pwd)" || {
        echo "Error: target path does not exist: $target" >&2
        exit 1
    }

    # Ensure central msgs directory exists (namespaced by target)
    local namespace
    namespace="$(resolve_namespace "$target_path")"
    local msgs_dir="${MSGS_DIR}/${namespace}"
    mkdir -p "$msgs_dir"

    # Write message body to handoff file in central store
    local handoff_path="${msgs_dir}/${filename}"
    if [ -n "$inline_msg" ]; then
        printf '%s\n' "$inline_msg" > "$handoff_path"
    elif [ -t 0 ]; then
        # Interactive: drop into $EDITOR (fallback nano/vi) with a seeded template
        local editor="${VISUAL:-${EDITOR:-}}"
        if [ -z "$editor" ]; then
            if command -v nano >/dev/null 2>&1; then editor=nano
            else editor=vi
            fi
        fi
        {
            echo "# txlit message to ${target_path}"
            echo "# Lines starting with # are stripped. Save & quit to send; empty body aborts."
            echo ""
        } > "$handoff_path"
        "$editor" "$handoff_path"
        # Strip comment lines
        grep -v '^#' "$handoff_path" > "${handoff_path}.tmp" && mv "${handoff_path}.tmp" "$handoff_path"
    else
        cat > "$handoff_path"
    fi

    if [ ! -s "$handoff_path" ]; then
        rm -f "$handoff_path"
        echo "Error: empty message body (use -m flag or pipe via stdin)" >&2
        exit 1
    fi

    # Ensure initialized + recover from empty/corrupt registry
    if [ ! -f "$MESSAGES_FILE" ]; then
        echo "Error: txlit not initialized. Is the plugin enabled?" >&2
        exit 1
    fi
    if [ ! -s "$MESSAGES_FILE" ] || ! jq empty "$MESSAGES_FILE" 2>/dev/null; then
        echo '{}' > "$MESSAGES_FILE"
    fi

    # Generate message ID
    local msg_id
    msg_id="$(uuidgen | tr '[:upper:]' '[:lower:]' | cut -c1-8)"

    # Sender = current project or working directory
    local from_path="${CLAUDE_PROJECT_DIR:-$PWD}"
    from_path="$(cd "$from_path" 2>/dev/null && pwd)" || from_path="${CLAUDE_PROJECT_DIR:-$PWD}"

    # For async-background modes: capture inbox cursor BEFORE registry write
    # so any reply arriving after this point gets picked up by the wait loop.
    local async_cursor=0
    if [ -n "$async_mode" ]; then
        async_cursor="$(jq --arg p "$from_path" '(.[$p] // []) | length' "$MESSAGES_FILE" 2>/dev/null || echo 0)"
    fi

    # Timestamp
    local timestamp
    timestamp="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"

    # Dual-write: queue + live channel (one path; status auto-set if listener is live)
    local _compose_status
    _compose_status="$(dual_write_message "$target_path" "$msg_id" "$from_path" "$handoff_path" "$timestamp" "$namespace")"

    # In async modes, stdout is reserved for reply body / JSON records.
    local _out
    if [ -n "$async_mode" ]; then _out=2; else _out=1; fi
    {
        echo "Composed and registered message ${msg_id}"
        echo "  to:      ${target_path}"
        echo "  file:    ${filename}"
    } >&${_out}

    # Deliver: launch kitty pane alongside existing claudes, start claude with file
    if [ "$deliver" = true ]; then
        if ! command -v kitty > /dev/null 2>&1; then
            echo "  [!!] --deliver requires kitty with remote control enabled" >&2
            return
        fi

        # Find an existing pane in the target's directory to anchor the new pane
        local anchor_id
        anchor_id="$(kitty @ ls 2>/dev/null | jq -r --arg cwd "$target_path" \
          '[.[].tabs[].windows[] | select(.cwd == $cwd)] | first | .id // empty' 2>/dev/null)"

        local pane_id
        if [ -n "$anchor_id" ]; then
            # Open as a new tab in the same OS window as the existing pane
            pane_id="$(kitty @ launch --type=tab --match "id:${anchor_id}" \
              --cwd "$target_path" --title "txlit: ${filename}" 2>/dev/null)"
        else
            # No existing pane — open a new OS window
            pane_id="$(kitty @ launch --type=os-window \
              --cwd "$target_path" --title "txlit: ${filename}" 2>/dev/null)"
        fi

        if [ -z "$pane_id" ]; then
            echo "  [!!] kitty remote control failed — is allow_remote_control enabled?" >&2
            return
        fi

        # Start claude and feed it the file reference as first message
        kitty @ send-text --match "id:${pane_id}" "claude \"@${handoff_path}\"\n" 2>/dev/null

        echo "  deliver: pane ${pane_id} launched at ${target_path}"
    fi

    # --tmux <name>: start (or attach) a tmux session in the target's cwd
    # running `cat " " | claude`. The single-space stdin gives claude a
    # prompt submission, firing UserPromptSubmit → the txlit hook delivers
    # this just-registered message.
    if [ -n "$tmux_name" ]; then
        if ! command -v tmux >/dev/null 2>&1; then
            echo "  [!!] --tmux requires tmux on PATH" >&2
        else
            local _tmux_out=1
            [ -n "$async_mode" ] && _tmux_out=2
            echo "  tmux:    starting session '${tmux_name}' at ${target_path}" >&${_tmux_out}
            tmux new-session -A -s "$tmux_name" -c "$target_path" "echo ' ' | claude"
        fi
    fi

    # Async background modes: send compose to stderr (so stdout stays clean
    # for reply body) then enter the wait loop.
    if [ -n "$async_mode" ]; then
        _asyncbg_wait_loop "$from_path" "$target_path" "$async_cursor" "$async_mode" "$timeout_sec"
    fi
}

# --- async-background wait loop -------------------------------------
# Polls messages.json for new entries to $inbox_path from $target_path
# at indices >= $cursor. Marks consumed entries as read.
#
# mode = "single"   → exit 0 on first reply, write body to stdout
# mode = "monitor"  → emit JSON-line per reply, loop until timeout/signal
_asyncbg_wait_loop() {
    local inbox_path="$1"
    local target_path="$2"
    local cursor="$3"
    local mode="$4"
    local timeout_sec="$5"

    # Default timeouts: 600s for single, 0 (infinite) for monitor
    if [ -z "$timeout_sec" ]; then
        if [ "$mode" = "single" ]; then timeout_sec=600
        else timeout_sec=0
        fi
    fi

    # In monitor mode, exit cleanly on SIGTERM/SIGINT
    trap 'exit 0' TERM INT

    # Move compose stdout banner out of the way — body output goes to stdout
    # from here on. (echoes already happened above; from now on we write to
    # stdout only for replies.)

    local start_epoch
    start_epoch="$(date +%s)"
    local poll_interval="0.5"

    # Track consumed message IDs (space-delimited) to avoid double-emit
    # if a hook concurrently flips status to read.
    local seen_ids=" "

    while :; do
        # Timeout check
        if [ "$timeout_sec" -gt 0 ]; then
            local now_epoch
            now_epoch="$(date +%s)"
            if [ $((now_epoch - start_epoch)) -ge "$timeout_sec" ]; then
                exit 124
            fi
        fi

        # Query new entries from target at or after cursor that we haven't seen
        if [ -s "$MESSAGES_FILE" ] && jq empty "$MESSAGES_FILE" 2>/dev/null; then
            local new_entries
            new_entries="$(jq -r --arg p "$inbox_path" \
                                  --arg t "$target_path" \
                                  --argjson c "$cursor" \
                '(.[$p] // [])[$c:]
                 | map(select(.from == $t))
                 | .[]
                 | [.id, .handoff, .timestamp] | @tsv' \
                "$MESSAGES_FILE" 2>/dev/null)"

            if [ -n "$new_entries" ]; then
                while IFS=$'\t' read -r msg_id handoff ts; do
                    [ -z "$msg_id" ] && continue
                    case "$seen_ids" in
                        *" $msg_id "*) continue ;;
                    esac
                    seen_ids="${seen_ids}${msg_id} "

                    local body=""
                    if [ -f "$handoff" ]; then
                        body="$(cat "$handoff")"
                    fi

                    # Atomically mark this message read
                    if [ -s "$MESSAGES_FILE" ] && jq empty "$MESSAGES_FILE" 2>/dev/null; then
                        if messages_lock_acquire 2>/dev/null; then
                            jq --arg p "$inbox_path" --arg id "$msg_id" \
                               '.[$p] = ((.[$p] // []) | map(if .id == $id then .status = "read" else . end))' \
                               "$MESSAGES_FILE" | json_write "$MESSAGES_FILE" 2>/dev/null || true
                            messages_lock_release
                        fi
                    fi

                    if [ "$mode" = "single" ]; then
                        printf '%s\n' "$body"
                        exit 0
                    else
                        # Monitor: emit single-line JSON record (jq escapes for us)
                        jq -cn --arg id "$msg_id" \
                               --arg from "$target_path" \
                               --arg ts "$ts" \
                               --arg body "$body" \
                               '{id:$id, from:$from, ts:$ts, body:$body}'
                    fi
                done <<EOF
$new_entries
EOF
            fi
        fi

        sleep "$poll_interval"
    done
}

# --- send -----------------------------------------------------------
cmd_send() {
    local target_path="" handoff_file="" inline_body=""

    while [ $# -gt 0 ]; do
        case "$1" in
            -m) inline_body="$2"; shift 2 ;;
            -h|--help)
                cat <<'SENDHELP' >&2
Usage:
  txlit send <target> <handoff-file>      # send pre-written file in msgs dir
  txlit send <target> -m "<body>"         # send inline body (auto-creates file)
  cat body.md | txlit send <target> -m -  # body from stdin

Writes to BOTH messages.json (queue, hook-delivered on recipient's next prompt)
AND channels/<target>.jsonl (live stream, picked up by `txlit listen` via Monitor).
If recipient is currently listening, queue entry is marked read on write so the
hook does not double-deliver.
SENDHELP
                return 0 ;;
            *)
                if [ -z "$target_path" ]; then target_path="$1"
                elif [ -z "$handoff_file" ]; then handoff_file="$1"
                else echo "Unexpected arg: $1" >&2; exit 1
                fi
                shift ;;
        esac
    done

    if [ -z "$target_path" ]; then
        echo "Usage: txlit send <target> {<handoff-file> | -m '<body>'}" >&2
        exit 1
    fi

    # Inline body: read stdin if -m -, else use the literal arg
    if [ -n "$inline_body" ]; then
        if [ "$inline_body" = "-" ]; then
            inline_body="$(cat)"
        fi
    elif [ -z "$handoff_file" ]; then
        echo "Error: provide either a handoff file or -m '<body>'." >&2
        exit 1
    fi

    # Resolve registered name → path
    target_path="$(resolve_target "$target_path")"

    # Resolve to absolute path
    target_path="$(cd "$target_path" 2>/dev/null && pwd)" || {
        echo "Error: target path does not exist: $1" >&2
        exit 1
    }

    # Resolve namespace and msgs dir
    local namespace
    namespace="$(resolve_namespace "$target_path")"
    mkdir -p "${MSGS_DIR}/${namespace}"

    local handoff_path
    if [ -n "$inline_body" ]; then
        # Auto-create handoff file from inline body
        local ts_short sender_ns
        ts_short="$(date -u +"%Y%m%dT%H%M%SZ")"
        sender_ns="$(resolve_namespace "$(cd "${CLAUDE_PROJECT_DIR:-$PWD}" 2>/dev/null && pwd || echo "$PWD")")"
        handoff_file="${ts_short}-${sender_ns}--${namespace}-$(uuidgen | tr '[:upper:]' '[:lower:]' | cut -c1-6).md"
        handoff_path="${MSGS_DIR}/${namespace}/${handoff_file}"
        printf '%s\n' "$inline_body" > "$handoff_path"
    else
        handoff_path="${MSGS_DIR}/${namespace}/${handoff_file}"
        if [ ! -f "$handoff_path" ]; then
            echo "Error: handoff file not found: ${handoff_path}" >&2
            exit 1
        fi
    fi

    # Clean front matter: agents in tx sessions may write tx/core instead of core/core
    if echo "$target_path" | grep -qi "tx"; then
        if head -20 "$handoff_path" | grep -q 'tx/core'; then
            sed -i '' 's|tx/core|core/core|g' "$handoff_path"
            echo "  [fix] Rewrote tx/core → core/core in front matter"
        fi
    fi

    # Ensure initialized + recover from empty/corrupt registry
    if [ ! -f "$MESSAGES_FILE" ]; then
        echo "Error: txlit not initialized. Is the plugin enabled?" >&2
        exit 1
    fi
    if [ ! -s "$MESSAGES_FILE" ] || ! jq empty "$MESSAGES_FILE" 2>/dev/null; then
        echo '{}' > "$MESSAGES_FILE"
    fi

    # Generate message ID
    local msg_id
    msg_id="$(uuidgen | tr '[:upper:]' '[:lower:]' | cut -c1-8)"

    # Sender = current project or working directory
    local from_path="${CLAUDE_PROJECT_DIR:-$PWD}"

    # Timestamp
    local timestamp
    timestamp="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"

    local queue_status
    queue_status="$(dual_write_message "$target_path" "$msg_id" "$from_path" "$handoff_path" "$timestamp" "$namespace")"

    echo "Sent ${msg_id} → ${namespace} (queue=${queue_status})"
    echo "  handoff: ${handoff_file}"
}

# --- list -----------------------------------------------------------
cmd_list() {
    local filter_path="${1:-}"

    if [ ! -f "$MESSAGES_FILE" ]; then
        echo "No messages (txlit not initialized)"
        return
    fi

    if [ -n "$filter_path" ]; then
        # Resolve registered name → path
        filter_path="$(resolve_target "$filter_path")"
        filter_path="$(cd "$filter_path" 2>/dev/null && pwd)" || filter_path="$1"

        local count
        count="$(jq --arg p "$filter_path" '.[$p] // [] | length' "$MESSAGES_FILE")"

        if [ "$count" = "0" ]; then
            echo "No messages for ${filter_path}"
            return
        fi

        echo "Messages for ${filter_path} (${count}):"
        jq -r --arg p "$filter_path" \
          '.[$p] // [] | .[] | "  [\(.id)] \(.status)  from \(.from | split("/") | last)  \(.timestamp)  \(.handoff | split("/") | last)"' \
          "$MESSAGES_FILE"
    else
        local total
        total="$(jq '[.[] | length] | add // 0' "$MESSAGES_FILE")"

        if [ "$total" = "0" ]; then
            echo "No pending messages"
            return
        fi

        echo "All messages (${total}):"
        jq -r 'to_entries[] | select(.value | length > 0) | "\n\(.key):", (.value[] | "  [\(.id)] \(.status)  from \(.from | split("/") | last)  \(.timestamp)  \(.handoff | split("/") | last)")' \
          "$MESSAGES_FILE"
    fi
}

# --- clear ----------------------------------------------------------
cmd_clear() {
    local clear_path="${1:-}"
    local msg_id="${2:-}"

    if [ -z "$clear_path" ]; then
        echo "Usage: txlit clear <path> [message-id]" >&2
        exit 1
    fi

    if [ ! -f "$MESSAGES_FILE" ]; then
        echo "No messages (txlit not initialized)"
        return
    fi

    # Resolve registered name → path
    clear_path="$(resolve_target "$clear_path")"
    clear_path="$(cd "$clear_path" 2>/dev/null && pwd)" || clear_path="$1"

    if [ -n "$msg_id" ]; then
        # Remove specific message
        messages_lock_acquire || { echo "Error: could not lock messages.json" >&2; exit 1; }
        jq --arg p "$clear_path" --arg id "$msg_id" \
          'if .[$p] then .[$p] |= map(select(.id != $id)) | if .[$p] | length == 0 then del(.[$p]) else . end else . end' \
          "$MESSAGES_FILE" | json_write "$MESSAGES_FILE"
        messages_lock_release
        echo "Cleared message ${msg_id} from ${clear_path}"
    else
        # Remove all for path
        messages_lock_acquire || { echo "Error: could not lock messages.json" >&2; exit 1; }
        jq --arg p "$clear_path" 'del(.[$p])' "$MESSAGES_FILE" | json_write "$MESSAGES_FILE"
        messages_lock_release
        echo "Cleared all messages for ${clear_path}"
    fi
}

# --- register -------------------------------------------------------
cmd_register() {
    local name="${1:-}"
    local reg_path="${2:-$PWD}"
    local intent="${3:-}"

    if [ -z "$name" ]; then
        echo "Usage: txlit register <name> [path] [intent]" >&2
        echo "" >&2
        echo "  name     Alias for the project (e.g., prototypologist)" >&2
        echo "  path     Project directory (default: current directory)" >&2
        echo "  intent   What this project is about" >&2
        exit 1
    fi

    # Reject dash-prefixed names — they collide with CLI flags and poison resolve_namespace
    case "$name" in
        -*)
            echo "Error: name cannot start with '-' (looks like a flag): '${name}'" >&2
            echo "Hint: if you meant to pass a flag, run 'txlit register --help'." >&2
            exit 1 ;;
    esac

    # Resolve to absolute path
    reg_path="$(cd "$reg_path" 2>/dev/null && pwd)" || {
        echo "Error: path does not exist: ${2:-$PWD}" >&2
        exit 1
    }

    # Ensure registry exists
    if [ ! -f "$REGISTRY_FILE" ]; then
        echo '{}' > "$REGISTRY_FILE"
    fi

    if [ -n "$intent" ]; then
        jq --arg name "$name" --arg path "$reg_path" --arg intent "$intent" \
          '.[$name] = {"path":$path,"intent":$intent}' "$REGISTRY_FILE" | json_write "$REGISTRY_FILE"
        echo "Registered '${name}' → ${reg_path}"
        echo "  intent: ${intent}"
    else
        # Preserve existing intent if re-registering with new path
        jq --arg name "$name" --arg path "$reg_path" \
          'if .[$name] | type == "object" then .[$name].path = $path else .[$name] = {"path":$path} end' \
          "$REGISTRY_FILE" | json_write "$REGISTRY_FILE"
        echo "Registered '${name}' → ${reg_path}"
    fi
}

# --- start ----------------------------------------------------------
# Spin up (or attach) a tmux session for a registered project. Used to bring
# projects back online after a reboot — every session is named verbatim after
# its registered name so `voice-to-ass`'s retarget macro can find it directly.
cmd_start() {
    local name=""
    local resume=false
    local cmd_to_run="claude"

    while [ $# -gt 0 ]; do
        case "$1" in
            -r|--resume) resume=true; shift ;;
            --cmd) cmd_to_run="$2"; shift 2 ;;
            -h|--help)
                cat <<'STARTHELP'
txlit start <name> [--resume] [--cmd <command>]

Create (or attach to) a tmux session named <name>, running <command> in the
project's registered directory. Idempotent — if the session already exists,
prints the attach command and exits.

  --resume       Pass --resume to the default `claude` command
  --cmd <cmd>    Run a different command instead of `claude`
STARTHELP
                return 0 ;;
            -*) echo "Unknown flag: $1" >&2; return 1 ;;
            *)
                if [ -z "$name" ]; then name="$1"; else echo "Unexpected arg: $1" >&2; return 1; fi
                shift ;;
        esac
    done

    if [ -z "$name" ]; then
        echo "Usage: txlit start <name> [--resume] [--cmd <command>]" >&2
        return 1
    fi
    if ! command -v tmux >/dev/null 2>&1; then
        echo "Error: tmux not found on PATH" >&2
        return 1
    fi

    # Resolve registered name → repo path. Fail loudly if unregistered, so
    # the user doesn't accidentally start sessions in random cwds.
    local path
    path="$(resolve_target "$name")"
    if [ "$path" = "$name" ] || [ ! -d "$path" ]; then
        echo "Error: '${name}' is not a registered project (run 'txlit register ${name}' first)" >&2
        return 1
    fi
    path="$(cd "$path" 2>/dev/null && pwd)" || {
        echo "Error: registered path does not exist: $path" >&2
        return 1
    }

    # Idempotent attach — if the session is already alive, don't relaunch it.
    if tmux has-session -t "=${name}" 2>/dev/null; then
        echo "Session '${name}' already running."
        echo "  attach: tmux attach -t =${name}"
        return 0
    fi

    # --resume is a sugar flag for the default `claude` command only; if the
    # user overrode --cmd, we hand off responsibility for resume semantics.
    local inner="$cmd_to_run"
    if [ "$resume" = true ] && [ "$cmd_to_run" = "claude" ]; then
        inner="claude --resume"
    fi

    tmux new-session -d -s "$name" -c "$path" "$inner"
    echo "Started session '${name}' in ${path} (running: ${inner})"
    echo "  attach: tmux attach -t =${name}"
}

# --- intent ---------------------------------------------------------
cmd_intent() {
    local name="${1:-}"
    local intent="${2:-}"

    if [ -z "$name" ] || [ -z "$intent" ]; then
        echo "Usage: txlit intent <name> <intent>" >&2
        exit 1
    fi

    if [ ! -f "$REGISTRY_FILE" ]; then
        echo "No registered names" >&2
        exit 1
    fi

    # Ensure entry exists
    if ! jq -e --arg name "$name" '.[$name]' "$REGISTRY_FILE" > /dev/null 2>&1; then
        echo "Name '${name}' not found. Register it first." >&2
        exit 1
    fi

    jq --arg name "$name" --arg intent "$intent" \
      'if .[$name] | type == "object" then .[$name].intent = $intent else .[$name] = {"path":.[$name],"intent":$intent} end' \
      "$REGISTRY_FILE" | json_write "$REGISTRY_FILE"

    echo "Updated intent for '${name}': ${intent}"
}

# --- unregister -----------------------------------------------------
cmd_unregister() {
    local name="${1:-}"

    if [ -z "$name" ]; then
        echo "Usage: txlit unregister <name>" >&2
        exit 1
    fi

    if [ ! -f "$REGISTRY_FILE" ]; then
        echo "No registered names"
        return
    fi

    if jq -e --arg name "$name" '.[$name]' "$REGISTRY_FILE" > /dev/null 2>&1; then
        jq --arg name "$name" 'del(.[$name])' "$REGISTRY_FILE" | json_write "$REGISTRY_FILE"
        echo "Unregistered '${name}'"
    else
        echo "Name '${name}' not found" >&2
        exit 1
    fi
}

# --- who ------------------------------------------------------------
cmd_who() {
    if [ ! -f "$REGISTRY_FILE" ]; then
        echo "No registered names"
        return
    fi

    local count
    count="$(jq 'length' "$REGISTRY_FILE")"

    if [ "$count" = "0" ]; then
        echo "No registered names"
        return
    fi

    echo "Registered names (${count}):"
    jq -r 'to_entries[] |
      if .value | type == "object" then
        "  \(.key)  →  \(.value.path)" + (if .value.intent then "\n    \(.value.intent)" else "" end)
      else
        "  \(.key)  →  \(.value)"
      end' "$REGISTRY_FILE"
}

# --- help -----------------------------------------------------------
cmd_help() {
    cat << 'HELP'
txlit - Inter-agent messaging for Claude Code

USAGE:
  txlit register <name> [path] [intent] Name a project (default: current dir)
  txlit start <name> [--resume]       Spin up (or attach) a tmux session for a project
  txlit intent <name> <intent>        Update a project's intent
  txlit unregister <name>             Remove a named project
  txlit who                           List registered names + intents
  txlit inbox                          Check messages for current project
  txlit compose [--deliver] [-m <msg>] <target|name> [file]
                                     Write + register a message
                                     Body: -m flag, stdin pipe/heredoc, or \$EDITOR
                                     --deliver: launch kitty pane, start claude
  txlit send <target|name> <handoff>  Register an existing handoff file
  txlit term <command>                Terminal integration (kitty)
                                     Run 'txlit term -h' for details
  txlit list [path|name]              Show pending messages
  txlit clear <path|name> [id]        Remove messages
  txlit help                          Show this help

WORKFLOW:
  1. Register project names:    txlit register backend ~/projects/backend
  2. Compose a message:         txlit compose backend msg.md <<< "content"
  3. Receiving agent gets it on next prompt
  4. Clear after processing:    txlit clear backend

  Alternative (pre-written file):
  1. Write handoff to:          ~/.config/txlit/msgs/<name>/YYYY-MM-DD-name.md
  2. Register it:               txlit send backend 2026-02-13-setup-auth.md

FILES:
  ~/.config/txlit/messages.json           Global message registry
  ~/.config/txlit/registry.json           Named project aliases
  ~/.config/txlit/msgs/<namespace>/*.md   Handoff instruction files

EXAMPLES:
  txlit compose backend 2026-03-11-auth-bug.md <<'EOF'
  # Auth bug: tokens expire early
  JWT tokens expire after 5 min instead of 60.
  EOF

  txlit compose backend -m 'JWT tokens expire after 5 min'
  txlit register prototypologist ~/projects/prototypologist "AI prototyping sandbox"
  txlit send prototypologist 2026-02-13-setup-auth.md
  txlit list
  txlit clear prototypologist
  txlit who
HELP
}

# --- agent-help -----------------------------------------------------
cmd_agent_help() {
    cat << 'AGENTHELP'
# txlit — Inter-Agent Messaging for Claude Code

Send messages between Claude Code projects. Messages auto-deliver on the recipient's next prompt via a UserPromptSubmit hook.

## Checking Your Inbox

```bash
txlit inbox
```

Shows unread and read messages for the current project.

## Sending Messages

Use `txlit compose` to write and register a message in one step. Messages are stored centrally in `~/.config/txlit/msgs/` — no files are written to the target project's directory.

Three input styles — filename is optional in all (auto-generated as `YYYY-MM-DD-xxxxxx.md`):

```bash
# 1. Inline flag (shortest, for one-liners)
txlit compose <target> -m 'Your message here'

# 2. Heredoc / pipe (preferred for multi-line AI-authored content)
txlit compose <target> <<'EOF'
multi-line
body here
EOF
echo "body" | txlit compose <target>

# 3. Interactive editor (humans at a tty with no -m and no pipe)
txlit compose <target>   # drops into $EDITOR with a seeded template

# Optional explicit filename
txlit compose <target> custom-name.md -m 'body'

# --deliver: also launch a new kitty pane and start claude with the message
txlit compose --deliver <target> -m 'Your message here'

# --tmux <name>: start (or attach) a tmux session in the target's cwd
# running `echo ' ' | claude` so the UserPromptSubmit hook fires and the
# just-registered message is delivered. The session takes over the current
# terminal until detached.
txlit compose --tmux session-name <target> -m 'Your message here'
```

Detection: stdin tty → editor; stdin piped → cat; `-m` → inline (skips both).

- `target`: registered project name (run `txlit who` to list)
- `filename`: convention is `YYYY-MM-DD-description.md` (auto-generated)

## Synchronous-Feeling RPC (background wait)

Default txlit messaging is fire-and-forget — replies arrive via the UserPromptSubmit hook on your NEXT prompt. That's broken for agent-to-agent RPC. Use `--async-background` when you need an answer before continuing.

### Single-reply RPC

```bash
txlit compose --async-background <target> -m '<question>'
```

Sends the message, then BLOCKS this process until a reply arrives in the current project's inbox from `<target>`. On reply: writes the reply body to stdout and exits 0. On `--timeout`: exits 124.

INVOKE THIS VIA `Bash(run_in_background=true)`. The harness notifies you when the background process exits. Do NOT call it in the foreground — you will just sit there until reply or timeout, burning context.

Pattern:
1. `Bash(command="txlit compose --async-background <target> -m '...'", run_in_background=true)` → returns a bg id immediately
2. Continue with other work
3. Harness notifies when bg exits → read its stdout for the reply body

### Streaming channel (back-and-forth)

```bash
txlit compose --async-background-monitor <target> -m '<opener>'
```

Same setup, but does not exit on first reply. Each subsequent reply from `<target>` is emitted as a single-line JSON record on stdout:

```
{"id":"...","from":"...","ts":"...","body":"..."}
```

INVOKE THIS VIA the `Monitor` tool — each stdout line becomes one notification. Pair with `Bash` send-calls to reply back.

If BOTH agents launch monitor toward each other, the conversation lives entirely in the two stdout streams — neither agent's UserPromptSubmit hook fires for these messages. You experience it as a chat log, not as discrete file handoffs.

### When to use which

| Mode | Use for |
|------|---------|
| Default (no flag) | Fire-and-forget. Recipient sees it next prompt. Handoffs, status reports, async memos. |
| `--async-background` | One question, one answer. Lookups, confirmations, "is X ready" pings. |
| `--async-background-monitor` | Sustained collaboration. Two agents working together for a while. |

### Flags

- `--timeout <seconds>` — default 600 for asyncbg, infinite for monitor. Exit 124 on timeout.

## Channels (many-to-one streaming pub/sub)

For lightweight ambient updates where the recipient just wants to watch ONE file and many publishers want to push at it without blocking. No inbox entry, no hook, no reply path.

```bash
# Publisher (any project) — fire-and-forget
txlit publish <target> -m 'build green'
echo 'tests passing' | txlit publish <target>

# Recipient — truncates own channel file, then tails it forever
txlit listen
```

`listen` truncates `~/.config/txlit/channels/<me>.jsonl` on start (clean slate per session) then `tail -F`s it. Each appended record is emitted as one JSON line on stdout:

```
{"id":"...","from":"<sender-project>","ts":"...","body":"..."}
```

INVOKE `txlit listen` VIA the `Monitor` tool — each stdout line becomes one notification. Publishers from any registered project can append; the recipient sees them as a live stream.

Differences from `--async-background-monitor`:
- Many-to-one (channels) vs one-to-one (monitor RPC)
- Publishers never block; no reply path
- File is truncated on every `listen` start (no replay, no history)

## Commands

| Command | Purpose |
|---------|---------|
| `txlit inbox` | Check messages for current project |
| `txlit compose <target> [file]` | Write + register message (-m or stdin) |
| `txlit publish <target>` | Append JSON-line to <target>'s channel (fire-and-forget) |
| `txlit listen` | Truncate + tail current project's channel; one JSON-line per record (Monitor-friendly) |
| `txlit term grab` | Pull kitty terminal output into current session |
| `txlit term relay <target> [label]` | Grab kitty terminal output and send as message |
| `txlit send <target> <file>` | Register a pre-written handoff file |
| `txlit who` | List registered projects |
| `txlit list [target]` | Show pending messages for a target |
| `txlit clear <target> [id]` | Remove delivered messages |

## Rules

- Use `compose` for cross-project messages (bypasses sandbox restrictions)
- Use `send` only when the handoff file already exists in `~/.config/txlit/msgs/<namespace>/`
- Run `txlit who` before sending to verify the target name exists
- Filenames follow `YYYY-MM-DD-description.md` convention
- Messages are markdown — include enough context for the recipient to act
AGENTHELP
}

# --- term -----------------------------------------------------------
cmd_term_help() {
    cat << 'TERMHELP'
txlit term - Terminal integration (kitty)

USAGE:
  txlit term grab [--extent <type>] [--match <window>]
  txlit term relay [--deliver] [--extent <type>] [--match <window>] <target> [label]
  txlit term help

COMMANDS:
  grab     Pull terminal output from kitty into current session (stdout)
  relay    Grab terminal output and send as a message to another project

OPTIONS:
  --extent <type>    What to capture (default: last_cmd_output)
                     last_cmd_output, last_non_empty_output, screen, selection
  --match <window>   Kitty window match expression (default: recent:1)
  --deliver          (relay only) Launch kitty pane and start claude with message

EXAMPLES:
  txlit term grab                              # last command output to stdout
  txlit term grab --extent selection            # selected text to stdout
  txlit term grab --match title:server          # from specific window
  txlit term relay backend                      # last cmd output → backend
  txlit term relay backend build-error          # with label
  txlit term relay --extent selection backend   # selected text → backend
  txlit term relay --deliver backend hotfix     # send + launch claude

REQUIRES:
  kitty with allow_remote_control enabled and shell_integration active.
TERMHELP
}

cmd_term() {
    local subcmd="${1:-help}"
    shift 2>/dev/null || true
    case "$subcmd" in
        grab)           cmd_term_grab "$@" ;;
        relay)          cmd_term_relay "$@" ;;
        help|-h|--help) cmd_term_help ;;
        *)              echo "Unknown term command: $subcmd" >&2; cmd_term_help >&2; exit 1 ;;
    esac
}

# --- term grab ------------------------------------------------------
cmd_term_grab() {
    local extent="last_cmd_output"
    local match_arg=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --extent)  extent="$2"; shift 2 ;;
            --match) match_arg="$2"; shift 2 ;;
            -*) echo "Unknown flag: $1" >&2; exit 1 ;;
            *)  echo "Unexpected argument: $1" >&2; exit 1 ;;
        esac
    done

    if ! command -v kitty > /dev/null 2>&1; then
        echo "Error: kitty not found" >&2
        exit 1
    fi

    local kitty_cmd="kitty @ get-text --extent ${extent}"
    if [ -n "$match_arg" ]; then
        kitty_cmd="${kitty_cmd} --match ${match_arg}"
    else
        kitty_cmd="${kitty_cmd} --match recent:1"
    fi

    local captured
    captured="$(eval "$kitty_cmd" 2>&1)" || {
        echo "Error: kitty remote control failed" >&2
        echo "  Is allow_remote_control enabled? Is shell_integration active?" >&2
        echo "  Detail: ${captured}" >&2
        exit 1
    }

    if [ -z "$captured" ]; then
        echo "Error: no output captured from kitty" >&2
        exit 1
    fi

    printf '%s\n' "$captured"
}

# --- term relay -----------------------------------------------------
cmd_term_relay() {
    local target=""
    local label=""
    local extent="last_cmd_output"
    local deliver=false
    local match_arg=""

    # Parse flags
    while [ $# -gt 0 ]; do
        case "$1" in
            --deliver) deliver=true; shift ;;
            --extent)  extent="$2"; shift 2 ;;
            --match) match_arg="$2"; shift 2 ;;
            -*) echo "Unknown flag: $1" >&2; exit 1 ;;
            *)
                if [ -z "$target" ]; then target="$1"
                elif [ -z "$label" ]; then label="$1"
                fi
                shift ;;
        esac
    done

    if [ -z "$target" ]; then
        echo "Usage: txlit term relay [--deliver] [--extent <type>] [--match <window>] <target> [label]" >&2
        echo "" >&2
        echo "  Grabs output from kitty terminal and sends it as a message." >&2
        echo "" >&2
        echo "  target     Registered name or path (see: txlit who)" >&2
        echo "  label      Short descriptor for filename (default: relay)" >&2
        echo "  --deliver  Also launch kitty pane and start claude with message" >&2
        echo "  --extent   Kitty get-text extent (default: last_cmd_output)" >&2
        echo "             Options: last_cmd_output, last_non_empty_output, screen, selection" >&2
        echo "  --match    Kitty window match expression (default: recent:1)" >&2
        echo "" >&2
        echo "Examples:" >&2
        echo "  txlit term relay backend                    # last cmd output → backend" >&2
        echo "  txlit term relay backend build-error        # with label" >&2
        echo "  txlit term relay --extent selection backend  # selected text → backend" >&2
        echo "  txlit term relay --match title:server backend # from specific window" >&2
        exit 1
    fi

    # Verify kitty remote control
    if ! command -v kitty > /dev/null 2>&1; then
        echo "Error: kitty not found" >&2
        exit 1
    fi

    # Build kitty get-text command
    local kitty_cmd="kitty @ get-text --extent ${extent}"
    if [ -n "$match_arg" ]; then
        kitty_cmd="${kitty_cmd} --match ${match_arg}"
    else
        kitty_cmd="${kitty_cmd} --match recent:1"
    fi

    # Grab text from kitty
    local captured
    captured="$(eval "$kitty_cmd" 2>&1)" || {
        echo "Error: kitty remote control failed" >&2
        echo "  Is allow_remote_control enabled? Is shell_integration active?" >&2
        echo "  Detail: ${captured}" >&2
        exit 1
    }

    if [ -z "$captured" ]; then
        echo "Error: no output captured from kitty" >&2
        exit 1
    fi

    # Generate filename
    local date_prefix
    date_prefix="$(date +"%Y-%m-%d")"
    local safe_label="${label:-relay}"
    safe_label="$(echo "$safe_label" | tr ' /' '-' | tr '[:upper:]' '[:lower:]')"
    local filename="${date_prefix}-${safe_label}.md"

    # Build compose args
    local compose_args=()
    if [ "$deliver" = true ]; then
        compose_args+=(--deliver)
    fi
    compose_args+=("$target" "$filename")

    # Pipe captured output into compose
    echo "$captured" | cmd_compose "${compose_args[@]}"
}

# --- channels (publish/listen) --------------------------------------
# Fire-and-forget many-to-one streaming: publishers append JSON-lines to the
# recipient's channel file; recipient runs `txlit listen` once (typically via
# Claude's Monitor tool) and sees every publisher's writes as notifications.
#
# Channel file: ~/.config/txlit/channels/<recipient-name>.jsonl
# Record:       {"id","from","ts","body"}
# `listen` truncates on start (clean slate per session) then `tail -F`s.

cmd_publish() {
    local target="" body="" stdin_body=""

    while [ $# -gt 0 ]; do
        case "$1" in
            -m) body="$2"; shift 2 ;;
            -h|--help)
                cat <<'PUBHELP'
txlit publish <target> -m '<body>'
txlit publish <target> <<EOF
  body
EOF

Append one JSON-line to <target>'s channel file. Fire-and-forget — no inbox
entry, no UserPromptSubmit hook, no reply path. Recipient must be running
`txlit listen` (or otherwise tailing the channel file) to see it live.
PUBHELP
                return 0 ;;
            --) shift; target="${1:-}"; shift || true; break ;;
            -*) echo "Unknown flag: $1" >&2; return 1 ;;
            *)  if [ -z "$target" ]; then target="$1"; else echo "Unexpected arg: $1" >&2; return 1; fi; shift ;;
        esac
    done

    if [ -z "$target" ]; then
        echo "Error: target required. Usage: txlit publish <target> [-m body]" >&2
        return 1
    fi

    # Body resolution: -m wins; otherwise read stdin if piped
    if [ -z "$body" ]; then
        if [ ! -t 0 ]; then
            stdin_body="$(cat)"
            body="$stdin_body"
        fi
    fi
    if [ -z "$body" ]; then
        echo "Error: empty body. Pass -m '<text>' or pipe via stdin." >&2
        return 1
    fi

    # Resolve target → namespace (registered name or basename)
    local target_path target_ns
    target_path="$(resolve_target "$target")"
    target_ns="$(resolve_namespace "$target_path")"

    # Resolve sender from current project dir
    local from_dir from_ns
    from_dir="${CLAUDE_PROJECT_DIR:-$PWD}"
    from_dir="$(cd "$from_dir" 2>/dev/null && pwd)" || from_dir="$PWD"
    from_ns="$(resolve_namespace "$from_dir")"
    local from_session="${CLAUDE_CODE_SESSION_ID:-}"

    mkdir -p "$CHANNELS_DIR"
    local channel_file="${CHANNELS_DIR}/${target_ns}.jsonl"

    local msg_id timestamp record
    msg_id="$(uuidgen | tr '[:upper:]' '[:lower:]' | cut -c1-32)"
    timestamp="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"

    record="$(jq -cn \
        --arg id "$msg_id" \
        --arg from "$from_ns" \
        --arg session "$from_session" \
        --arg ts "$timestamp" \
        --arg body "$body" \
        '{id:$id, from:$from, from_session:$session, ts:$ts, body:$body}')"

    # Append atomically — single write(2) for small records, fine for our scale
    printf '%s\n' "$record" >> "$channel_file"

    echo "Published to ${target_ns} (${msg_id})"
}

cmd_listen() {
    case "${1:-}" in
        -h|--help|help)
            cat <<'EOF'
Usage: txlit listen

Truncate ~/.config/txlit/channels/<me>.jsonl and tail -F it.
Channel name is derived from the current project (CLAUDE_PROJECT_DIR or PWD).
One JSON record per appended line — meant to be driven by the Monitor tool.

Takes no arguments.
EOF
            return 0
            ;;
    esac
    # Resolve current project name
    local me_dir me_ns
    me_dir="${CLAUDE_PROJECT_DIR:-$PWD}"
    me_dir="$(cd "$me_dir" 2>/dev/null && pwd)" || me_dir="$PWD"
    me_ns="$(resolve_namespace "$me_dir")"

    # Per-agent identity. When several agents share this folder they share this
    # one channel file; each stamps its sends with CLAUDE_CODE_SESSION_ID, so we
    # can suppress our own echoes here without hiding a sibling agent's messages.
    local me_session="${CLAUDE_CODE_SESSION_ID:-}"

    mkdir -p "$CHANNELS_DIR"
    local channel_file="${CHANNELS_DIR}/${me_ns}.jsonl"
    local pidfile="${CHANNELS_DIR}/${me_ns}.pid"

    # Clean slate every session — this is a live stream, not an inbox
    : > "$channel_file"

    # Record our PID so senders can detect a live listener and skip hook re-delivery
    echo "$$" > "$pidfile"
    trap 'rm -f "$pidfile"' EXIT INT TERM HUP

    # Print one banner line to stderr so it doesn't pollute the JSON-line stream
    echo "Listening on channel: ${me_ns} (${channel_file})" >&2

    # Tail forever, emit each appended line on stdout — one record per Monitor notification
    # Note: not exec'd so the EXIT trap fires and the pidfile gets cleaned up
    if [ -n "$me_session" ]; then
        # Drop records this agent sent itself (from_session == me). Records with no
        # from_session (older/foreign writers) have null != $me → kept. --unbuffered
        # flushes each line immediately so Monitor sees it live.
        tail -n 0 -F "$channel_file" \
            | jq -c --unbuffered --arg me "$me_session" 'select(.from_session != $me)'
    else
        tail -n 0 -F "$channel_file"
    fi
}

# --- routing --------------------------------------------------------
case "${1:-}" in
    register)       shift; cmd_register "$@" ;;
    start)          shift; cmd_start "$@" ;;
    intent)         shift; cmd_intent "$@" ;;
    unregister)     shift; cmd_unregister "$@" ;;
    who)            shift; cmd_who "$@" ;;
    inbox)          shift; cmd_inbox "$@" ;;
    compose)        shift; cmd_compose "$@" ;;
    publish|pub)    shift; cmd_publish "$@" ;;
    listen)         shift; cmd_listen "$@" ;;
    term)           shift; cmd_term "$@" ;;
    send)           shift; cmd_send "$@" ;;
    list|ls)        shift; cmd_list "$@" ;;
    clear|rm)       shift; cmd_clear "$@" ;;
    agent-help|--agent-help) cmd_agent_help ;;
    help|-h|--help) cmd_help ;;
    "")             cmd_help ;;
    *)              echo "Unknown command: $1" >&2; cmd_help >&2; exit 1 ;;
esac
